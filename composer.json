{
  "name": "tourze/quic-core",
  "description": "QUIC协议核心基础库 - 协议常量、错误码、枚举类型和基础工具",
  "type": "library",
  "license": "MIT",
  "require": {
    "ext-ctype": "*",
    "ext-hash": "*",
    "ext-mbstring": "*",
    "tourze/arrayable": "1.*",
    "tourze/enum-extra": "0.1.*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "tourze/phpunit-base": "1.*",
    "tourze/phpunit-enum": "0.0.*",
    "tourze/symfony-testing-framework": "0.0.*"
  },
  "autoload": {
    "psr-4": {
      "Tourze\\QUIC\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tourze\\QUIC\\Core\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}